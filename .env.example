BOT_TOKEN=your_bot_token_here
BOT_VERSION=1.0.0
# Cooldown: 10m = 10 хвилин, 1h = 1 година, 1d = 1 день, 1w = 1 тиждень
COOLDOWN=1d
MIN_SIZE=-5
MAX_SIZE=10
INITIAL_SIZE=0
DB_PATH=dick_bot.db
# true = зберігати в SQLite, false = тримати розміри/кулдаун лише в пам'яті
SAVE_TO_DB=true
# Секунди мовчазного тротлінгу команд у групах для одного користувача та однієї команди. 0 = вимкнути
GROUP_THROTTLE_SECONDS=1
# Ціна скидання кулдауну /dick у зірках (Telegram Stars, XTR)
ATTEMPT_COST=25